# Kakao Developers → your app → REST API key.
# Server-only. Never prefix this variable with VITE_.
KAKAO_REST_API_KEY=

# Hosted Postgres connection string (use the provider's pooled URL on Vercel).
# Include its required TLS parameters. This is a server secret.
DATABASE_URL=

# Private reusable signup code: any nonempty value. Changing it blocks old
# codes for NEW signups; existing members keep access. No VITE_ prefix.
CLUB_INVITE_CODE=
